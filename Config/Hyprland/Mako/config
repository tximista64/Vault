# Catppuccin Mocha (Mauve accent) - matches the cursor theme & yazi flavor

sort=-time
layer=overlay
anchor=top-right
width=340
height=110
margin=12
padding=14
border-size=2
border-radius=12
icons=1
max-icon-size=48
default-timeout=6000
ignore-timeout=0

font=Hack 10.5

background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#cba6f7

progress-color=over #313244
[urgency=low]
border-color=#6c7086
text-color=#a6adc8

[urgency=normal]
border-color=#cba6f7
text-color=#cdd6f4

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
