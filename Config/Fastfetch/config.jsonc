{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "color": {
            "1": "#b875dc",
            "2": "#8658a1"
        },
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#b875dc",
            "title": "#8658a1"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "break",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
